ENV=development                      # development | production
APP_BASE_URL=http://localhost:10000  # used in email links
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brain_monkey
JWT_SECRET=change-me-to-64-random-chars   # python -c "import secrets;print(secrets.token_urlsafe(64))"
COOKIE_SECURE=false                  # true in production (HTTPS)
TRUST_PROXY=false                    # true on Render: reads the rightmost X-Forwarded-For entry
GOOGLE_CLIENT_ID=                    # Google Cloud Console > OAuth Web client
# Beta access control
ADMIN_EMAILS=you@example.com         # admins: exempt from the seat cap, can add/view/remove users
MAX_USERS=100
REGISTRATION_MODE=open               # open (until MAX_USERS) | invite_only
# Email: brevo | resend | console (console just logs the link; dev only)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@yourdomain.com   # must be a verified sender/domain at the provider
EMAIL_FROM_NAME=Monkey Brain
BREVO_API_KEY=
RESEND_API_KEY=
# Content generation (critical thinking, art and S-mode use Gemini, with Groq as fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SOLVER_MODEL=gemini-2.5-flash-lite
# Groq Cloud fallback (free tier: gpt-oss-120b/openai-gpt-oss-20b ~1K req/day, 8K TPM each)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_S=30.0             # chunked requests: ~2/min stays under 8K TPM
GROQ_MAX_COMPLETION_TOKENS=4096      # room for reasoning + JSON in one chunk
GROQ_REASONING_EFFORT=low            # keep gpt-oss thinking short so the JSON fits
GENERATION_PACE_S=10.0               # pause between pillars in a multi-pillar run
INTERNAL_CRON_SECRET=                # 24+ random chars; required in production
S_MODE_ENABLED=true                  # kill switch for the hidden S-mode section
